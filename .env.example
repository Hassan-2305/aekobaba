# ── App ─────────────────────────────────────────────────────────────────────
# Canonical site URL — used for metadata (Open Graph / Twitter absolute URLs).
# REQUIRED in production: without it, social previews fall back to the Vercel
# deployment URL (or localhost in development) and shared links lose their image.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Inbox for "Request a supplier" on categories with no listings yet.
NEXT_PUBLIC_CONTACT_EMAIL=""

# ── Supplier reviews (optional) ─────────────────────────────────────────────
# Individual review cards on product pages come ONLY from the platforms'
# official APIs (copying review text from their sites is not permitted).
# Without a key that source is skipped; ratings, star breakdown and summaries
# still show. Server-only — never prefix with NEXT_PUBLIC_.
# Google Places API (New): Google Cloud console → enable "Places API (New)".
GOOGLE_PLACES_API_KEY=""
# Trustpilot API key (issued by Trustpilot to business accounts).
TRUSTPILOT_API_KEY=""

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Copy this file to `.env` and fill in real values from your Supabase project
# (Project Settings → Database and Project Settings → API).
# Full walkthrough: docs/supabase-setup.md

# App runtime connection — Supabase pooler (transaction mode), port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Migrations and Prisma CLI — direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — safe for the browser (NEXT_PUBLIC_ prefixed).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Anon key — safe for the browser; access is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Service role key — SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
