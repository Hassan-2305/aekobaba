generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  role                   Role                   @default(BRAND)
  supabaseUserId         String                 @unique
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  brandProfile           BrandProfile?
  quoteRequests          QuoteRequest[]
  sampleRequests         SampleRequest[]
  savedLists             SavedList[]
  supplierOrg            Supplier?              @relation("SupplierOwner")
  /// Display name and phone, captured when the buyer submits a request.
  name                   String?
  phone                  String?
  basket                 Basket?
  assignedRequests       QuoteRequest[]         @relation("QuoteAssignee")
  assignedSupplierLines  QuoteRequestSupplier[] @relation("QuoteSupplierAssignee")
  quoteActivities        QuoteActivity[]
  outreachRecorded       SupplierOutreach[]
  supplierQuotesRecorded SupplierQuote[]
  applications           SupplierApplication[]
}

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  region      String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Supplier {
  id                      String                 @id @default(cuid())
  slug                    String                 @unique
  name                    String
  website                 String
  location                String
  legalIdentity           String?
  reviewScore             Float?
  reviewCount             Int                    @default(0)
  lastVerifiedAt          DateTime?
  status                  SupplierStatus         @default(PENDING)
  isPartner               Boolean                @default(false)
  responseTimeHours       Int?
  logoUrl                 String?
  ownerUserId             String?                @unique
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  certifications          Certification[]
  featuredPlacements      FeaturedPlacement[]
  partnerSubscriptions    PartnerSubscription[]
  products                Product[]
  reviews                 Review[]
  owner                   User?                  @relation("SupplierOwner", fields: [ownerUserId], references: [id])
  /// Verified business inbox the Aekovera team writes RFQs to (mailto).
  businessEmail           String?
  businessEmailVerifiedAt DateTime?
  quoteRequestSuppliers   QuoteRequestSupplier[]

  @@index([location])
  @@index([status])
  @@index([reviewScore])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  createdAt   DateTime   @default(now())
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
}

model Product {
  id                   String             @id @default(cuid())
  supplierId           String
  categoryId           String
  title                String
  description          String?
  material             String
  subcategory          String?
  priceType            PriceType
  basePrice            Decimal?           @db.Decimal(12, 4)
  priceBasis           String?
  priceUnit            Decimal?           @db.Decimal(12, 4)
  moq                  Int?
  moqUnit              String?
  leadTimeDays         Int?
  stockOrCustom        StockOrCustom
  samplePolicyVerified Boolean            @default(false)
  sourceUrl            String
  sourceCapturedAt     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  images               Image[]
  inquiries            Inquiry[]
  category             Category           @relation(fields: [categoryId], references: [id])
  supplier             Supplier           @relation(fields: [supplierId], references: [id])
  quantityBreaks       QuantityBreak[]
  quoteRequestItems    QuoteRequestItem[]
  sampleRequests       SampleRequest[]
  savedListItems       SavedListItem[]
  basketItems          BasketItem[]

  @@unique([supplierId, title])
  @@index([supplierId])
  @@index([categoryId])
  @@index([priceType])
  @@index([stockOrCustom])
  @@index([material])
  @@index([moq])
  @@index([leadTimeDays])
}

model QuantityBreak {
  id        String  @id @default(cuid())
  productId String
  minQty    Int
  maxQty    Int?
  unitPrice Decimal @db.Decimal(12, 4)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Image {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id               String   @id @default(cuid())
  supplierId       String
  score            Float
  sourcePlatform   String
  reviewedAt       DateTime
  sourceUrl        String
  sourceCapturedAt DateTime
  summary          String?
  createdAt        DateTime @default(now())
  supplier         Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model Certification {
  id               String   @id @default(cuid())
  supplierId       String
  name             String
  authority        String?
  sourceUrl        String
  sourceCapturedAt DateTime
  createdAt        DateTime @default(now())
  supplier         Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, name])
}

model QuoteRequest {
  id             String                 @id @default(cuid())
  brandUserId    String
  status         QuoteStatus            @default(DRAFT)
  deadline       DateTime?
  artworkNotes   String?
  artworkFileUrl String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  brand          User                   @relation(fields: [brandUserId], references: [id])
  items          QuoteRequestItem[]
  /// Human reference used in emails and the dashboard, e.g. "AEK-261019-7KQ4".
  reference      String?                @unique
  stage          RequestStage           @default(NEW)
  /// Buyer contact snapshot at submission (the account can change later).
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  companyName    String?
  /// Buyer's requirements for the whole request.
  notes          String?
  assignedToId   String?
  assignedTo     User?                  @relation("QuoteAssignee", fields: [assignedToId], references: [id])
  nextAction     String?
  nextActionDue  DateTime?
  internalNotes  String?
  suppliers      QuoteRequestSupplier[]
  activities     QuoteActivity[]

  @@index([brandUserId])
  @@index([status])
  @@index([stage])
}

model QuoteRequestItem {
  id                   String              @id @default(cuid())
  quoteRequestId       String
  productId            String
  quantity             Int
  status               QuoteItemStatus     @default(SENT)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  product              Product             @relation(fields: [productId], references: [id])
  quoteRequest         QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  /// Buyer's specification notes for this line.
  specNotes            String?
  sampleStatus         SampleStatus        @default(NOT_REQUESTED)
  sampleCarrier        String?
  sampleTracking       String?
  sampleDispatchedAt   DateTime?
  sampleDeliveredAt    DateTime?
  customerFeedback     CustomerFeedback?
  customerFeedbackNote String?
  supplierFeedbackNote String?
  quoteLines           SupplierQuoteLine[]

  @@index([quoteRequestId])
  @@index([productId])
  @@index([status])
  @@index([sampleStatus])
}

/// One supplier inside one RFQ — outreach and commercial progress are tracked
/// per supplier, independently of each other and of sample status.
model QuoteRequestSupplier {
  id               String             @id @default(cuid())
  quoteRequestId   String
  supplierId       String
  outreachStatus   OutreachStatus     @default(NOT_CONTACTED)
  commercialStatus CommercialStatus   @default(AWAITING_QUOTE)
  lastContactAt    DateTime?
  lastReplyAt      DateTime?
  lastReplySummary String?
  /// The supplier quote the buyer can see (set when the team shares one).
  sharedQuoteId    String?
  nextAction       String?
  nextActionDue    DateTime?
  assignedToId     String?
  internalNotes    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  quoteRequest     QuoteRequest       @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplier         Supplier           @relation(fields: [supplierId], references: [id])
  assignedTo       User?              @relation("QuoteSupplierAssignee", fields: [assignedToId], references: [id])
  outreach         SupplierOutreach[]
  quotes           SupplierQuote[]

  @@unique([quoteRequestId, supplierId])
  @@index([outreachStatus])
  @@index([commercialStatus])
}

/// Every contact attempt and reply, recorded by the team (replies are logged
/// by hand — the app does not read the team's mailbox).
model SupplierOutreach {
  id                     String               @id @default(cuid())
  quoteRequestSupplierId String
  direction              OutreachDirection
  channel                OutreachChannel      @default(EMAIL)
  subject                String?
  summary                String
  occurredAt             DateTime             @default(now())
  recordedById           String?
  createdAt              DateTime             @default(now())
  quoteRequestSupplier   QuoteRequestSupplier @relation(fields: [quoteRequestSupplierId], references: [id], onDelete: Cascade)
  recordedBy             User?                @relation(fields: [recordedById], references: [id])

  @@index([quoteRequestSupplierId])
}

/// A supplier's actual offer, as received by the team.
model SupplierQuote {
  id                     String               @id @default(cuid())
  quoteRequestSupplierId String
  receivedAt             DateTime             @default(now())
  currency               String               @default("USD")
  leadTimeDays           Int?
  validUntil             DateTime?
  terms                  String?
  notes                  String?
  recordedById           String?
  createdAt              DateTime             @default(now())
  quoteRequestSupplier   QuoteRequestSupplier @relation(fields: [quoteRequestSupplierId], references: [id], onDelete: Cascade)
  recordedBy             User?                @relation(fields: [recordedById], references: [id])
  lines                  SupplierQuoteLine[]

  @@index([quoteRequestSupplierId])
}

model SupplierQuoteLine {
  id                 String           @id @default(cuid())
  supplierQuoteId    String
  quoteRequestItemId String
  unitPrice          Decimal          @db.Decimal(12, 4)
  quantity           Int?
  moq                Int?
  notes              String?
  supplierQuote      SupplierQuote    @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)
  quoteRequestItem   QuoteRequestItem @relation(fields: [quoteRequestItemId], references: [id], onDelete: Cascade)

  @@index([supplierQuoteId])
  @@index([quoteRequestItemId])
}

/// Audit trail: every status change and team action on an RFQ.
model QuoteActivity {
  id             String       @id @default(cuid())
  quoteRequestId String
  actorId        String?
  kind           String
  message        String
  createdAt      DateTime     @default(now())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id])

  @@index([quoteRequestId])
  @@index([createdAt])
}

/// Persistent Quote Basket for signed-in buyers (guests keep theirs in the browser).
model Basket {
  id        String       @id @default(cuid())
  userId    String       @unique
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BasketItem[]
}

model BasketItem {
  id        String   @id @default(cuid())
  basketId  String
  productId String
  quantity  Int
  addedAt   DateTime @default(now())
  basket    Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([basketId, productId])
}

/// "List your company", "Fetch products from my site" and "Become a partner".
model SupplierApplication {
  id              String            @id @default(cuid())
  reference       String            @unique
  type            ApplicationType
  status          ApplicationStatus @default(PENDING)
  applicantUserId String?
  companyName     String
  website         String
  location        String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  categories      String[]
  catalogUrls     String[]
  message         String?
  internalNotes   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  applicant       User?             @relation(fields: [applicantUserId], references: [id])
  meeting         PartnerMeeting?

  @@index([type, status])
  @@index([createdAt])
}

model PartnerMeeting {
  id            String              @id @default(cuid())
  applicationId String              @unique
  status        MeetingStatus       @default(BOOKING_PENDING)
  scheduledAt   DateTime?
  outcome       String?
  followUp      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  application   SupplierApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

/// Outbox for automated emails: written in the same transaction as the event,
/// delivered afterwards, retried until sent — a failed send never loses the event.
model NotificationOutbox {
  id        String       @id @default(cuid())
  kind      String
  toEmail   String
  subject   String
  textBody  String
  htmlBody  String?
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
}

model SampleRequest {
  id          String              @id @default(cuid())
  brandUserId String
  productId   String
  quantity    Int?
  notes       String?
  status      SampleRequestStatus @default(REQUESTED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  brand       User                @relation(fields: [brandUserId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])

  @@index([brandUserId])
  @@index([productId])
  @@index([status])
}

model SavedList {
  id          String          @id @default(cuid())
  brandUserId String
  name        String          @default("Shortlist")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  brand       User            @relation(fields: [brandUserId], references: [id])
  items       SavedListItem[]

  @@unique([brandUserId, name])
}

model SavedListItem {
  id          String    @id @default(cuid())
  savedListId String
  productId   String
  note        String?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id])
  savedList   SavedList @relation(fields: [savedListId], references: [id], onDelete: Cascade)

  @@unique([savedListId, productId])
  @@index([productId])
}

model PartnerSubscription {
  id         String    @id @default(cuid())
  supplierId String
  plan       String?
  startedAt  DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  supplier   Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model FeaturedPlacement {
  id         String    @id @default(cuid())
  supplierId String
  placement  String?
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  supplier   Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model Inquiry {
  id              String        @id @default(cuid())
  kind            InquiryKind
  status          InquiryStatus @default(NEW)
  productId       String
  name            String
  email           String
  company         String?
  website         String?
  phone           String?
  quantity        String
  packagingType   String?
  format          String?
  designStatus    DesignStatus?
  description     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accessTokenHash String?
  product         Product       @relation(fields: [productId], references: [id])
  file            InquiryFile?

  @@index([status])
  @@index([productId])
  @@index([createdAt])
}

model InquiryFile {
  id          String   @id @default(cuid())
  inquiryId   String   @unique
  name        String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

enum Role {
  BRAND
  SUPPLIER
  ADMIN
}

enum SupplierStatus {
  PENDING
  LISTED
  RECOMMENDED
  QUOTE_ONLY
  DISABLED
}

enum PriceType {
  EXACT
  CALCULATOR
  FROM
  QUOTE_ONLY
}

enum StockOrCustom {
  STOCK
  CUSTOM
}

enum QuoteStatus {
  DRAFT
  SENT
  RESPONDED
  CLOSED
}

enum QuoteItemStatus {
  SENT
  QUOTED
  DECLINED
  EXPIRED
}

enum SampleRequestStatus {
  REQUESTED
  APPROVED
  SHIPPED
  DECLINED
}

enum InquiryKind {
  QUOTE
  SAMPLE
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum DesignStatus {
  READY
  IN_PROGRESS
  NEED_HELP
  NONE
}

enum RequestStage {
  NEW
  IN_PROGRESS
  QUOTES_SHARED
  COMPLETED
  CANCELLED
}

enum OutreachStatus {
  NOT_CONTACTED
  EMAIL_PREPARED
  CONTACTED
  REPLIED
  FOLLOW_UP_NEEDED
}

enum CommercialStatus {
  AWAITING_QUOTE
  QUOTE_RECEIVED
  REVIEWING
  SHARED_WITH_CUSTOMER
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SampleStatus {
  NOT_REQUESTED
  REQUESTED
  APPROVED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum CustomerFeedback {
  AWAITING_FEEDBACK
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum OutreachDirection {
  OUTBOUND
  INBOUND
}

enum OutreachChannel {
  EMAIL
  PHONE
  OTHER
}

enum ApplicationType {
  LISTING
  PRODUCT_FETCH
  PARTNERSHIP
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  CONTACTED
  AUTHORIZED
  EXTRACTING
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  CLOSED
}

enum MeetingStatus {
  BOOKING_PENDING
  BOOKED
  HELD
  NO_SHOW
  CANCELLED
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}
