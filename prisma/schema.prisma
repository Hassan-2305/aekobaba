generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  role           Role            @default(BRAND)
  supabaseUserId String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  brandProfile   BrandProfile?
  quoteRequests  QuoteRequest[]
  sampleRequests SampleRequest[]
  savedLists     SavedList[]
  supplierOrg    Supplier?       @relation("SupplierOwner")
}

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  region      String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Supplier {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  website              String
  location             String
  legalIdentity        String?
  reviewScore          Float?
  reviewCount          Int                   @default(0)
  lastVerifiedAt       DateTime?
  status               SupplierStatus        @default(PENDING)
  isPartner            Boolean               @default(false)
  responseTimeHours    Int?
  logoUrl              String?
  ownerUserId          String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  certifications       Certification[]
  featuredPlacements   FeaturedPlacement[]
  partnerSubscriptions PartnerSubscription[]
  products             Product[]
  reviews              Review[]
  owner                User?                 @relation("SupplierOwner", fields: [ownerUserId], references: [id])

  @@index([location])
  @@index([status])
  @@index([reviewScore])
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  createdAt   DateTime   @default(now())
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
}

model Product {
  id                   String             @id @default(cuid())
  supplierId           String
  categoryId           String
  title                String
  description          String?
  material             String
  subcategory          String?
  priceType            PriceType
  basePrice            Decimal?           @db.Decimal(12, 4)
  priceBasis           String?
  priceUnit            Decimal?           @db.Decimal(12, 4)
  moq                  Int?
  moqUnit              String?
  leadTimeDays         Int?
  stockOrCustom        StockOrCustom
  samplePolicyVerified Boolean            @default(false)
  sourceUrl            String
  sourceCapturedAt     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  images               Image[]
  inquiries            Inquiry[]
  category             Category           @relation(fields: [categoryId], references: [id])
  supplier             Supplier           @relation(fields: [supplierId], references: [id])
  quantityBreaks       QuantityBreak[]
  quoteRequestItems    QuoteRequestItem[]
  sampleRequests       SampleRequest[]
  savedListItems       SavedListItem[]

  @@unique([supplierId, title])
  @@index([supplierId])
  @@index([categoryId])
  @@index([priceType])
  @@index([stockOrCustom])
  @@index([material])
  @@index([moq])
  @@index([leadTimeDays])
}

model QuantityBreak {
  id        String  @id @default(cuid())
  productId String
  minQty    Int
  maxQty    Int?
  unitPrice Decimal @db.Decimal(12, 4)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Image {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id               String   @id @default(cuid())
  supplierId       String
  score            Float
  sourcePlatform   String
  reviewedAt       DateTime
  sourceUrl        String
  sourceCapturedAt DateTime
  summary          String?
  createdAt        DateTime @default(now())
  supplier         Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model Certification {
  id               String   @id @default(cuid())
  supplierId       String
  name             String
  authority        String?
  sourceUrl        String
  sourceCapturedAt DateTime
  createdAt        DateTime @default(now())
  supplier         Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, name])
}

model QuoteRequest {
  id             String             @id @default(cuid())
  brandUserId    String
  status         QuoteStatus        @default(DRAFT)
  deadline       DateTime?
  artworkNotes   String?
  artworkFileUrl String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  brand          User               @relation(fields: [brandUserId], references: [id])
  items          QuoteRequestItem[]

  @@index([brandUserId])
  @@index([status])
}

model QuoteRequestItem {
  id             String          @id @default(cuid())
  quoteRequestId String
  productId      String
  quantity       Int
  status         QuoteItemStatus @default(SENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        Product         @relation(fields: [productId], references: [id])
  quoteRequest   QuoteRequest    @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@index([productId])
  @@index([status])
}

model SampleRequest {
  id          String              @id @default(cuid())
  brandUserId String
  productId   String
  quantity    Int?
  notes       String?
  status      SampleRequestStatus @default(REQUESTED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  brand       User                @relation(fields: [brandUserId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])

  @@index([brandUserId])
  @@index([productId])
  @@index([status])
}

model SavedList {
  id          String          @id @default(cuid())
  brandUserId String
  name        String          @default("Shortlist")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  brand       User            @relation(fields: [brandUserId], references: [id])
  items       SavedListItem[]

  @@unique([brandUserId, name])
}

model SavedListItem {
  id          String    @id @default(cuid())
  savedListId String
  productId   String
  note        String?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id])
  savedList   SavedList @relation(fields: [savedListId], references: [id], onDelete: Cascade)

  @@unique([savedListId, productId])
  @@index([productId])
}

model PartnerSubscription {
  id         String    @id @default(cuid())
  supplierId String
  plan       String?
  startedAt  DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  supplier   Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model FeaturedPlacement {
  id         String    @id @default(cuid())
  supplierId String
  placement  String?
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  supplier   Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model Inquiry {
  id              String        @id @default(cuid())
  kind            InquiryKind
  status          InquiryStatus @default(NEW)
  productId       String
  name            String
  email           String
  company         String?
  website         String?
  phone           String?
  quantity        String
  packagingType   String?
  format          String?
  designStatus    DesignStatus?
  description     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accessTokenHash String?
  product         Product       @relation(fields: [productId], references: [id])
  file            InquiryFile?

  @@index([status])
  @@index([productId])
  @@index([createdAt])
}

model InquiryFile {
  id          String   @id @default(cuid())
  inquiryId   String   @unique
  name        String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
}

enum Role {
  BRAND
  SUPPLIER
  ADMIN
}

enum SupplierStatus {
  PENDING
  LISTED
  RECOMMENDED
  QUOTE_ONLY
  DISABLED
}

enum PriceType {
  EXACT
  CALCULATOR
  FROM
  QUOTE_ONLY
}

enum StockOrCustom {
  STOCK
  CUSTOM
}

enum QuoteStatus {
  DRAFT
  SENT
  RESPONDED
  CLOSED
}

enum QuoteItemStatus {
  SENT
  QUOTED
  DECLINED
  EXPIRED
}

enum SampleRequestStatus {
  REQUESTED
  APPROVED
  SHIPPED
  DECLINED
}

enum InquiryKind {
  QUOTE
  SAMPLE
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum DesignStatus {
  READY
  IN_PROGRESS
  NEED_HELP
  NONE
}
